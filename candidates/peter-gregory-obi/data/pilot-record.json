  "contradictions": [{"id":"contra-obi-debt-001","source_a":"SRC-OBI-DEBT-STATEMENT","source_b":"SRC-DMO-ANAMBRA-DOM-2013","relationship":"CONTRADICTS_OR_QUALIFIES","subject":"meaning of 'no debt' under Obi's administration","status":"QUALIFIED","classification":"DEFINITION_MISMATCH_OR_SCOPE_DIFFERENCE_PENDING_FURTHER_PRIMARY_RECORDS","note":"The 2015 statement concerns borrowing/raising bonds during the administration, while DMO reports formal debt stock outstanding at a point in time. The records must not be collapsed into a single proposition."}],
  "corrections": [{"id":"corr-obi-debt-assessment-001","v1":{"claim_id":"claim-debt-contradiction","version":"v1","assessment":"The statement that Obi's administration left no debt requires qualification when compared with DMO debt-stock records.","basis":["SRC-OBI-DEBT-STATEMENT","SRC-DMO-ANAMBRA-DOM-2013"]},"correction":{"type":"changed_evidentiary_assessment","reason":"The underlying records distinguish borrowing/raising bonds during the administration from debt stock outstanding at a later measurement date; the earlier wording risked treating different propositions as directly equivalent.","source_ids":["SRC-OBI-DEBT-STATEMENT","SRC-DMO-ANAMBRA-DOM-2013","SRC-DEBT-FACTCHECK"]},"v2":{"version":"v2","predecessor":"v1","assessment":"Obi's representative made a no-borrowing/no-bond statement for the administration; DMO separately reports Anambra debt stock at 31 December 2013. The evidence therefore supports qualification and does not by itself establish that Obi personally caused or did not cause every debt liability represented in the DMO stock."}}],
